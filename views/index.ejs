<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Drive</title>
</head>
<body>
  <h1>My Drive</h1>

  <form action="/logout" method="POST">
    <button type="submit">Logout</button>
  </form>

  <hr>

  <h2>Create Folder</h2>

  <form action="/folders" method="POST">
    <input
      type="text"
      name="name"
      placeholder="Folder name"
      required
    >

    <button type="submit">
      Create Folder
    </button>
  </form>

  <hr>

  <h2>Upload File</h2>

  <% if (error) { %>
  <div class="upload-error">
    <%= error %>
  </div>
<% } %>

  <form
    action="/upload"
    method="POST"
    enctype="multipart/form-data"
  >
    <input
      type="file"
      name="file"
      required
    >

    <button type="submit">
      Upload
    </button>
  </form>

  <hr>

  <h2>Folders</h2>

  <% if (folders && folders.length > 0) { %>
    <ul>
      <% folders.forEach(folder => { %>
        <li>
          <a href="/folders/<%= folder.id %>">
            📁 <%= folder.name %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No folders yet.</p>
  <% } %>

  <hr>

  <h2>Files</h2>

  <% if (files && files.length > 0) { %>
    <ul>
      <% files.forEach(file => { %>
        <li>
  📄
  <a href="/files/<%= file.id %>">
    <%= file.filename %>
  </a>
</li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No files yet.</p>
  <% } %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= folder.name %></title>
</head>
<body>
  <a href="/">← Back</a>

  <h1><%= folder.name %></h1>

  <hr>

  <h2>Create Subfolder</h2>

  <form action="/folders" method="POST">
    <input
      type="text"
      name="name"
      placeholder="Folder name"
      required
    >

    <input
      type="hidden"
      name="parentId"
      value="<%= folder.id %>"
    >

    <button type="submit">
      Create
    </button>
  </form>

  <hr>

  <h2>Upload File</h2>

  <% if (error) { %>
  <div class="upload-error">
    <%= error %>
  </div>
<% } %>

  <form
    action="/folders/<%= folder.id %>/upload"
    method="POST"
    enctype="multipart/form-data"
  >
    <input
      type="file"
      name="file"
      required
    >

    <button type="submit">
      Upload
    </button>
  </form>

  <hr>

  <h2>Folders</h2>

  <% if (folder.children.length > 0) { %>
    <ul>
      <% folder.children.forEach(child => { %>
        <li>
          <a href="/folders/<%= child.id %>">
            📁 <%= child.name %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No subfolders.</p>
  <% } %>

  <hr>

  <h2>Files</h2>

  <% if (folder.files.length > 0) { %>
    <ul>
      <% folder.files.forEach(file => { %>
        <li>
  📄
  <a href="/files/<%= file.id %>">
    <%= file.filename %>
  </a>
</li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No files.</p>
  <% } %>

  <hr>

<h2>Share Folder</h2>

<form action="/folders/<%= folder.id %>/share" method="POST">
  <label for="duration">Link expires after:</label>

  <select name="duration" id="duration" required>
    <option value="1">1 day</option>
    <option value="3">3 days</option>
    <option value="7">7 days</option>
    <option value="10">10 days</option>
    <option value="30">30 days</option>
  </select>

  <button type="submit">Create Share Link</button>
</form>
</body>
</html>
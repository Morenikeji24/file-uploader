<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Create Account - Drive</title>

    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body class="auth-page">
    <main class="auth-container">
      <div class="auth-card">
        <a href="/login" class="auth-logo"> ◈ Drive </a>

        <h1>Create your account</h1>

        <p class="auth-subtitle">Start storing and organizing your files.</p>

        <form action="/sign-up" method="POST" class="auth-form">
          <div class="form-group">
            <label for="email"> Email </label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="password"> Password </label>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="Create a password"
              required
            />
          </div>

          <button type="submit" class="button auth-button">
            Create account
          </button>
        </form>

        <p class="auth-footer">
          Already have an account?
          <a href="/login">Log in</a>
        </p>
      </div>
    </main>
  </body>
</html>

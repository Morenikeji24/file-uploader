
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Folder Shared</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="topbar">

    <a href="/" class="logo">
      ◈ Drive
    </a>

  </header>


  <main class="main-content">

    <div class="form-card share-card">

      <div class="share-icon">
        🔗
      </div>

      <h1>Folder shared</h1>

      <p>
        <strong><%= folder.name %></strong>
        can now be accessed by anyone with this link.
      </p>


      <div class="share-expiry">

        <span>Link expires</span>

        <strong>
          <%= shareExpiresAt.toLocaleString() %>
        </strong>

      </div>


      <div class="share-link">

        <input
          type="text"
          value="<%= shareUrl %>"
          readonly
          id="shareUrl"
        >

        <button
          class="button"
          type="button"
          onclick="copyLink()"
        >
          Copy
        </button>

      </div>


      <p id="copyMessage" class="copy-message"></p>


      <a
        href="/folders/<%= folder.id %>"
        class="button button-secondary"
      >
        Back to folder
      </a>

    </div>

  </main>


  <script>
    function copyLink() {
      const input = document.getElementById("shareUrl");

      navigator.clipboard.writeText(input.value);

      document.getElementById("copyMessage").textContent =
        "Link copied!";
    }
  </script>

</body>
</html>
```


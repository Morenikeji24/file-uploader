<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= folder.name %></title>
</head>

<body>

  <h1>📁 <%= folder.name %></h1>

  <p>This folder has been shared with you.</p>

  <% if (folder.id !== rootFolder.id) { %>
    <a href="/share/folders/<%= token %>">
      ← Back to shared folder
    </a>
  <% } %>

  <hr>

  <h2>Folders</h2>

  <% if (folder.children.length > 0) { %>

    <ul>
      <% folder.children.forEach(child => { %>
        <li>
          📁

          <a href="/share/folders/<%= token %>/<%= child.id %>">
            <%= child.name %>
          </a>
        </li>
      <% }) %>
    </ul>

  <% } else { %>

    <p>No subfolders.</p>

  <% } %>


  <h2>Files</h2>

  <% if (folder.files.length > 0) { %>

    <ul>
      <% folder.files.forEach(file => { %>
        <li>
          📄

          <a
            href="<%= file.filepath %>"
            target="_blank"
          >
            <%= file.filename %>
          </a>
        </li>
      <% }) %>
    </ul>

  <% } else { %>

    <p>No files.</p>

  <% } %>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= folder.name %></title>
</head>

<body>

  <h1>📁 <%= folder.name %></h1>

  <p>This folder has been shared with you.</p>

  <hr>

  <% function renderFolder(folder) { %>

    <section>
      <h2>📁 <%= folder.name %></h2>

      <% if (folder.files.length > 0) { %>

        <h3>Files</h3>

        <ul>
          <% folder.files.forEach(file => { %>
            <li>
              📄
              <a
                href="<%= file.filepath %>"
                target="_blank"
              >
                <%= file.filename %>
              </a>
            </li>
          <% }) %>
        </ul>

      <% } %>


      <% if (folder.children.length > 0) { %>

        <h3>Folders</h3>

        <% folder.children.forEach(child => { %>

          <div style="margin-left: 30px;">
            <% renderFolder(child) %>
          </div>

        <% }) %>

      <% } %>

    </section>

  <% } %>


  <% renderFolder(folder) %>

</body>
</html>